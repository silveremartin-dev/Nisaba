&P100001 = AAS 001
#atf: lang sux
@tablet
@obverse
1. 1(disz) udu niga
2. 1(disz) u8
3. ba-usz2 u4 2(u) 8(disz)-kam
4. ki ur-ru-ta
@reverse
1. kiszib3 lu2-kal-la
2. iti ezem-{d}szul-gi
3. mu {d}szu-{d}suen lugal
@seal 1
1. lu2-kal-la
2. dub-sar
3. dumu ur-e11-e szusz3

